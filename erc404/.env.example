# Optional overrides for the deployment script. If unset, the script uses its
# defaults. Set these on the command line or export them before running forge.
TOKEN_NAME="Monad ERC404"
TOKEN_SYMBOL="mE404"
MAX_NFT_SUPPLY=100

# Only needed if you sign with a raw private key instead of a Foundry keystore.
# Use a key that holds only testnet funds. Do not commit a real key.
# PRIVATE_KEY=0x...
